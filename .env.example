# Credenciales públicas del proyecto Supabase para el cliente web.
# No uses una service_role key ni otras credenciales administrativas aquí.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# legacy (predeterminado) mantiene Google Sheets; canonical consulta catalog_releases.
VITE_CATALOG_SOURCE=legacy
# Actívalo solo después de aplicar y validar la migración de fase 5.
VITE_EDITORIAL_ENABLED=false
# Kill switch de la consola administrativa. Nunca concede permisos: E06 los
# verifica con private.is_admin() en cada RPC.
VITE_ADMIN_CATALOG_ENABLED=false
# Kill switch de presentación para enlaces de invitación beta. No concede
# acceso, autenticación ni permisos a ningún canal de feedback.
VITE_BETA_INVITATION_ENABLED=false
