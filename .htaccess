RewriteEngine On
RewriteBase /

# "Crate" pasó a "colección": los enlaces compartidos con las rutas viejas
# redirigen con 301. Apache conserva la query; el navegador conserva el hash.
# Misma regla en el cliente: src/lib/domain/collectionRoutes.ts.
# /mis-colecciones (U31) lleva al perfil propio, pero su dirección depende de la
# sesión y Apache no la conoce: esa redirección vive solo en el cliente
# (src/routes/mis-colecciones/+page.svelte) y la ruta sigue cayendo en index.html.
RewriteRule ^mis-crates/?$ /mis-colecciones [R=301,L]
RewriteRule ^crate/([^/]+)/?$ /coleccion/$1 [R=301,L]

# La consola y la estación editorial se unieron en el Estudio (U15).
# Misma regla en el cliente: src/lib/domain/studio.ts.
RewriteRule ^admin/catalogo/?$ /estudio/catalogo [R=301,L]
RewriteRule ^editorial/?$ /estudio/propuestas [R=301,L]

# Vista previa de enlaces (2026-11-17): las fichas que se comparten pasan por
# vista-previa.php, que devuelve index.html con sus etiquetas Open Graph para
# WhatsApp y compañía. Si el script falla, devuelve index.html tal cual.
RewriteRule ^vista-previa\.config\.php$ - [F,L]
RewriteRule ^(lanzamiento|coleccion)/[^/]+/?$ /vista-previa.php [L]

RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
